# Copy to .env (gitignored). Only public values belong here: never the Supabase service role key.
# API origin; the client adds /api/v1. Lane ports: see docs/lanes.md.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-project-anon-key
# Dev server port (default 5173)
WEB_PORT=5173
