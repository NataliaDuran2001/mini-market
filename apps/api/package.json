{
  "name": "@mini-market/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "nest:module": "node -r @swc-node/register scripts/create-module.ts",
    "inventory:verify": "node --env-file-if-exists=.env -r @swc-node/register scripts/inventory-verify.ts",
    "provision": "node --env-file-if-exists=.env -r @swc-node/register scripts/provision-tenant.ts",
    "expenses:generate": "node --env-file-if-exists=.env -r @swc-node/register scripts/generate-expenses.ts",
    "setup:env": "node -r @swc-node/register scripts/setup-env.ts",
    "setup:db": "node --env-file-if-exists=.env -r @swc-node/register scripts/setup-database.ts",
    "setup:tenants": "node --env-file-if-exists=.env -r @swc-node/register scripts/setup-tenants.ts",
    "wipe:dev-data": "node --env-file-if-exists=.env -r @swc-node/register scripts/wipe-dev-data.ts",
    "smoke:local": "node --env-file-if-exists=.env -r @swc-node/register scripts/smoke-local.ts",
    "dev:token": "node --env-file-if-exists=.env -r @swc-node/register scripts/dev-token.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@mini-market/contracts": "workspace:*",
    "@mini-market/shared-kernel": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@t3-oss/env-core": "0.13.11",
    "drizzle-orm": "0.45.3",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@mini-market/config": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "eslint": "catalog:",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
