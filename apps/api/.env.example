# Copy to .env (gitignored). The API refuses to start when a required value is missing or malformed.
NODE_ENV=development
# Port: API_PORT wins, then PORT (set by hosts such as Railway), then 3001.
API_PORT=3001
LOG_LEVEL=info

# Postgres through the Supabase pooler (role app_user) or a local Postgres.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/postgres
# Owner role, read by `db:migrate`, `node dist/migrate.js` (Railway pre-deploy) and the provisioning
# script, never by the API: the migrations create the role app_user and the RLS policies. The
# migrate job falls back to DATABASE_URL; the provisioning script does not (it needs a role that
# bypasses RLS, such as the Supabase postgres role). After the first migration run in Supabase, give app_user a password by hand:
# ALTER ROLE app_user LOGIN PASSWORD '...'
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
# Server side only. Never in the web bundle, the repo or logs.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Exact web origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173
