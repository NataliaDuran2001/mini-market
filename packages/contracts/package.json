{
  "name": "@mini-market/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./dist/access/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./equity": {
      "types": "./dist/equity/index.d.ts",
      "default": "./dist/equity/index.js"
    },
    "./purchasing": {
      "types": "./dist/purchasing/index.d.ts",
      "default": "./dist/purchasing/index.js"
    },
    "./tenancy": {
      "types": "./dist/tenancy/index.d.ts",
      "default": "./dist/tenancy/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mini-market/shared-kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mini-market/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
